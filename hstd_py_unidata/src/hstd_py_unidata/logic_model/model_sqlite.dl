#pragma once
#include "logic_model/model_dsl.dl"

.decl input_qname(id: symbol, name: symbol, scope: symbol, scoped: number)
.decl input_type_shape(id: number, kind: symbol, name: symbol, detail: symbol, size: number)
.decl input_type_edge(owner: number, slot: number, nested: number)

.decl input_record(qname: symbol, kind: RecordKind)
.decl input_inherits(sub: symbol, sup: symbol)
.decl input_field(qname: symbol, name: FieldName, t: number)
.decl input_variant_case(owner: symbol, vfield: FieldName, tag: CaseTag, case_qname: symbol)
.decl input_variant_kind(owner: symbol, vfield: FieldName, kind_enum: symbol)
.decl input_enum_value(qname: symbol, name: EnumName)
.decl input_qname_text(qname: symbol, text: symbol)
.decl input_prim_text(prim: symbol, text: symbol)
.decl input_prim_class(prim: symbol, cls: symbol)
.decl input_class_text(cls: symbol, text: symbol)
.decl input_numeric_join(left: symbol, right: symbol, result: symbol)
.decl input_op_binds_elem(op: OpId)
.decl input_op_binary(op: OpId)

.decl input_expr(e: ExprId, op: OpId)
.decl input_expr_arity(e: ExprId, arity: ArgIndex)
.decl input_expr_arg(e: ExprId, idx: ArgIndex, arg: ExprId)
.decl input_expr_str(e: ExprId, value: symbol)
.decl input_expr_int(e: ExprId, value: number)
.decl input_expr_type_val(e: ExprId, t: number)
.decl input_expr_flag(e: ExprId, flag: Flag)
.decl input_binds(e: ExprId, slot: number, binder: BinderId)
.decl input_var_ref(e: ExprId, binder: BinderId)
.decl input_this_type(e: ExprId, t: number)
.decl input_root(e: ExprId, expected: number)
.decl input_expr_arg_class(e: ExprId, idx: ArgIndex, cls: symbol)
.decl input_expr_fixed_result(e: ExprId, t: number)

.decl sqlite_prim(name: symbol, value: Prim)
sqlite_prim("PInt8", $PInt8()).
sqlite_prim("PInt16", $PInt16()).
sqlite_prim("PInt32", $PInt32()).
sqlite_prim("PInt64", $PInt64()).
sqlite_prim("PUInt8", $PUInt8()).
sqlite_prim("PUInt16", $PUInt16()).
sqlite_prim("PUInt32", $PUInt32()).
sqlite_prim("PUInt64", $PUInt64()).
sqlite_prim("PFloat32", $PFloat32()).
sqlite_prim("PFloat64", $PFloat64()).
sqlite_prim("PString", $PString()).
sqlite_prim("PBool", $PBool()).
sqlite_prim("PAny", $PAny()).
sqlite_prim("PNone", $PNone()).
sqlite_prim("PPath", $PPath()).

.decl sqlite_class(name: symbol, value: TypeClass)
sqlite_class("CAny", $CAny()).
sqlite_class("CNumeric", $CNumeric()).
sqlite_class("CInteger", $CInteger()).
sqlite_class("CFloat", $CFloat()).
sqlite_class("CString", $CString()).
sqlite_class("CBool", $CBool()).
sqlite_class("COrdered", $COrdered()).
sqlite_class("CList", $CList()).
sqlite_class("CMap", $CMap()).
sqlite_class("COptional", $COptional()).

.decl sqlite_qname(id: symbol, value: QName)
sqlite_qname(I, $QNameValue(N, $NoScope())) :-
    input_qname(I, N, _, 0).
sqlite_qname(I, $QNameValue(N, $SomeScope(Q))) :-
    input_qname(I, N, S, 1),
    sqlite_qname(S, Q).

.decl sqlite_type(id: number, value: Type)
.decl sqlite_type_list(owner: number, slot: number, value: TypeList)

sqlite_type_list(I, N, $TNil()) :-
    input_type_shape(I, "tuple", _, _, N).
sqlite_type_list(I, S, $TCons(T, L)) :-
    input_type_shape(I, "tuple", _, _, _),
    input_type_edge(I, S, N),
    sqlite_type(N, T),
    sqlite_type_list(I, S + 1, L).

sqlite_type(I, $TPrim(P)) :-
    input_type_shape(I, "prim", N, _, _),
    sqlite_prim(N, P).
sqlite_type(I, $TList(T)) :-
    input_type_shape(I, "list", _, _, _),
    input_type_edge(I, 0, N),
    sqlite_type(N, T).
sqlite_type(I, $TArray(T, S)) :-
    input_type_shape(I, "array", _, _, S),
    input_type_edge(I, 0, N),
    sqlite_type(N, T).
sqlite_type(I, $TMap(K, V)) :-
    input_type_shape(I, "map", _, _, _),
    input_type_edge(I, 0, KI),
    input_type_edge(I, 1, VI),
    sqlite_type(KI, K),
    sqlite_type(VI, V).
sqlite_type(I, $TOpt(T)) :-
    input_type_shape(I, "optional", _, _, _),
    input_type_edge(I, 0, N),
    sqlite_type(N, T).
sqlite_type(I, $TTuple(L)) :-
    input_type_shape(I, "tuple", _, _, _),
    sqlite_type_list(I, 0, L).
sqlite_type(I, $TNamed(Q)) :-
    input_type_shape(I, "named", N, _, _),
    sqlite_qname(N, Q).
sqlite_type(I, $TExternal(P, Q)) :-
    input_type_shape(I, "external", N, P, _),
    sqlite_qname(N, Q).
sqlite_type(I, $TVariant(Q, F)) :-
    input_type_shape(I, "variant", N, F, _),
    sqlite_qname(N, Q).
sqlite_type(I, $TDyn(T)) :-
    input_type_shape(I, "dyn", _, _, _),
    input_type_edge(I, 0, N),
    sqlite_type(N, T).
sqlite_type(I, $TParam(N)) :-
    input_type_shape(I, "param", N, _, _).

record(Q, K) :- input_record(I, K), sqlite_qname(I, Q).
inherits(S, P) :- input_inherits(SI, PI), sqlite_qname(SI, S), sqlite_qname(PI, P).
field(Q, N, T) :- input_field(QI, N, TI), sqlite_qname(QI, Q), sqlite_type(TI, T).

variant_case(O, F, T, C) :-
    input_variant_case(OI, F, T, CI),
    sqlite_qname(OI, O),
    sqlite_qname(CI, C).
variant_kind(O, F, K) :-
    input_variant_kind(OI, F, KI),
    sqlite_qname(OI, O),
    sqlite_qname(KI, K).

enum_value(Q, N) :- input_enum_value(I, N), sqlite_qname(I, Q).
qname_text(Q, S) :- input_qname_text(I, S), sqlite_qname(I, Q).
prim_text(P, S) :- input_prim_text(N, S), sqlite_prim(N, P).
prim_class(P, C) :-
    input_prim_class(PN, CN),
    sqlite_prim(PN, P),
    sqlite_class(CN, C).
class_text(C, S) :- input_class_text(N, S), sqlite_class(N, C).
numeric_join(L, R, T) :-
    input_numeric_join(LN, RN, TN),
    sqlite_prim(LN, L),
    sqlite_prim(RN, R),
    sqlite_prim(TN, T).

op_binds_elem(O) :- input_op_binds_elem(O).
op_binary(O) :- input_op_binary(O).

expr(E, O) :- input_expr(E, O).
expr_arity(E, N) :- input_expr_arity(E, N).
expr_arg(E, I, A) :- input_expr_arg(E, I, A).
expr_str(E, S) :- input_expr_str(E, S).
expr_int(E, N) :- input_expr_int(E, N).
expr_type_val(E, T) :- input_expr_type_val(E, I), sqlite_type(I, T).
expr_flag(E, F) :- input_expr_flag(E, F).
binds(E, S, B) :- input_binds(E, S, B).
var_ref(E, B) :- input_var_ref(E, B).
this_type(E, T) :- input_this_type(E, I), sqlite_type(I, T).
root(E, T) :- input_root(E, I), sqlite_type(I, T).
expr_arg_class(E, I, C) :- input_expr_arg_class(E, I, N), sqlite_class(N, C).
expr_fixed_result(E, T) :- input_expr_fixed_result(E, I), sqlite_type(I, T).

.decl sqlite_output_type_id(t: Type, id: number)
sqlite_output_type_id(T, autoinc()) :- type_seen(T).

.decl sq_inferred_type(e: ExprId, t: number)
sq_inferred_type(E, I) :-
    inferred_type(E, T),
    sqlite_output_type_id(T, I).

.decl sq_inferred_binder_type(e: ExprId, slot: number, t: number)
sq_inferred_binder_type(E, S, I) :-
    inferred_binder_type(E, S, T),
    sqlite_output_type_id(T, I).

.decl sq_inferred_type_shape(
    t: number,
    kind: symbol,
    name: symbol,
    detail: symbol,
    size: number
)
sq_inferred_type_shape(I, K, N, D, S) :-
    inferred_type_shape(T, K, N, D, S),
    sqlite_output_type_id(T, I).

.decl sq_inferred_type_edge(t: number, slot: number, nested: number)
sq_inferred_type_edge(I, S, N) :-
    inferred_type_edge(T, S, V),
    sqlite_output_type_id(T, I),
    sqlite_output_type_id(V, N).

import json
import sys
from pathlib import Path

from conan import ConanFile
from conan.tools.env import Environment


CONFIGURATION = json.loads(
    Path(__file__).with_name("conandata.yml").read_text(encoding="utf-8")
)["fixture"]


class ExampleNativePackage(ConanFile):
    name = CONFIGURATION["name"]
    version = "0.1.0"

    python_requires = "haxorg_conan_base/0.1.0"
    python_requires_extend = "haxorg_conan_base.HaxorgPackage"

    if CONFIGURATION["executable"]:
        package_type = "application"
    elif CONFIGURATION["nanobind"]:
        package_type = "shared-library"
    else:
        package_type = "header-library"

    provided_binaries = (
        [CONFIGURATION["name"]]
        if CONFIGURATION["executable"]
        else None
    )
    haxorg_use_cmake_install = True
    haxorg_package_libs = ()

    exports_sources = (
        "CMakeLists.txt",
        "fixture.cmake",
        "fixture.json",
        "src/*",
        "proto/*",
        "tests/*",
    )

    def requirements(self):
        configuration = self.conan_data["fixture"]

        if configuration["nanobind"]:
            self.requires("nanobind/[>=2.9.2 <3]")

        if configuration["protobuf"] and not configuration["shared_schema"]:
            self.requires("ex_cpp_shared_schema/0.1.0")

    def haxorg_configure_layout(self):
        self.cpp.build.bindirs = ["."]
        self.cpp.build.libdirs = ["."]
        self.cpp.package.bindirs = ["bin"]
        self.cpp.package.libdirs = ["lib"]

    def haxorg_configure_toolchain(self, toolchain):
        if self.conan_data["fixture"]["nanobind"]:
            toolchain.cache_variables["Python_EXECUTABLE"] = self.conf.get(
                "user.haxorg:python_executable",
                default=sys.executable,
                check_type=str,
            )

    def build(self):
        environment = Environment()
        environment.define("EX_NATIVE_BUILD_DIR", self.build_folder)
        environment.define("EX_NATIVE_SOURCE_DIR", self.source_folder)

        with environment.vars(self).apply():
            super().build()

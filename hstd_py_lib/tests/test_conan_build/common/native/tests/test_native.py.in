import importlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path


def test_native_build() -> None:
    source = Path(os.environ["EX_NATIVE_SOURCE_DIR"])
    build = Path(os.environ["EX_NATIVE_BUILD_DIR"])
    configuration = json.loads(
        (source / "fixture.json").read_text(encoding="utf-8")
    )
    name = configuration["name"]

    header = source / "src" / name / "value.hpp"
    match = re.search(
        r"inline constexpr int value = (\d+);",
        header.read_text(encoding="utf-8"),
    )
    assert match is not None
    value = int(match.group(1))
    assert value > 0

    if configuration["executable"]:
        result = subprocess.run(
            [str(build / name)],
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        )
        assert int(result.stdout.strip()) == value

    if configuration["nanobind"]:
        extensions = list(build.glob(f"{name}*.so"))
        assert len(extensions) == 1, extensions

        sys.path.insert(0, str(build))
        module = importlib.import_module(name)
        assert module.value() == value
        assert Path(module.__file__).resolve() == extensions[0].resolve()

    if configuration["protobuf"]:
        schema_name = (
            "shared.proto"
            if configuration["shared_schema"]
            else "api.proto"
        )
        schema = source / "proto" / name / schema_name
        assert 'syntax = "proto3";' in schema.read_text(encoding="utf-8")

    print(f"EX_NATIVE_PYTEST:{name}:{value}")

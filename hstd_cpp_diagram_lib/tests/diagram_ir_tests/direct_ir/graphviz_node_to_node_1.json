{
  "collections": [
    {
      "payload": {
        "@type": "type.googleapis.com/hstd.ext.graph.proto.TrivialEdgeCollectionPayload"
      },
      "edges"  : [
        {
          "payload"         : {
            "@type": "type.googleapis.com/hstd.ext.graph.proto.TrivialEdgePayload"
          },
          "source_vertex_id": "vert-1",
          "target_vertex_id": "vert-2",
          "stable_id"       : "vert-vert",
          "attributes"      : [
            {
              "payload": {
                "@type": "type.googleapis.com/hstd.ext.graph.gv.proto.EdgeAttributePayload",
                "parent_stable_id": "vert-root"
              }
            }
          ]
        }
      ]
    }
  ],
  "hierarchies": [
    {
      "payload"      : {
        "@type": "type.googleapis.com/hstd.ext.graph.proto.TrivialVertexHierarchyPayload"
      },
      "nested_in_map": { "vert-root": { "vertices": ["vert-1", "vert-2"] } }
    }
  ],
  "ports"      : [
    {
      "payload": {
        "@type": "type.googleapis.com/hstd.ext.graph.proto.TrivialPortCollectionPayload"
      }
    }
  ],
  "vertices"   : [
    {
      "stable_id" : "vert-root",
      "payload"   : {
        "@type": "type.googleapis.com/hstd.ext.graph.proto.TrivialVertexPayload"
      },
      "attributes": [
        {
          "payload": {
            "@type": "type.googleapis.com/hstd.ext.graph.gv.proto.GroupAttributePayload"
          }
        }
      ]
    },
    {
      "stable_id" : "vert-1",
      "payload"   : {
        "@type": "type.googleapis.com/hstd.ext.graph.proto.TrivialVertexPayload"
      },
      "attributes": [
        {
          "payload": {
            "@type": "type.googleapis.com/hstd.ext.graph.gv.proto.NodeAttributePayload",
            "parent_stable_id": "vert-root",
            "height": 10,
            "width": 10
          }
        }
      ]
    },
    {
      "stable_id" : "vert-2",
      "payload"   : {
        "@type": "type.googleapis.com/hstd.ext.graph.proto.TrivialVertexPayload"
      },
      "attributes": [
        {
          "payload": {
            "@type": "type.googleapis.com/hstd.ext.graph.gv.proto.NodeAttributePayload",
            "parent_stable_id": "vert-root",
            "height": 10,
            "width": 10
          }
        }
      ]
    }
  ]
}

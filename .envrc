export ASAN_OPTIONS="detect_leaks=0"
export CCACHE_DISABLE=1
export JAVA_HOME=/usr/lib/jvm/default
export UV_VERBOSE=1

# export UV_ENV_FILE=/home/haxscramper/defaultdirs/workspace/haxorg/build/haxorg_release/dev_env
export CMAKE_BUILD_PARALLEL_LEVEL=28
export KDE_DEBUG=1

export CONAN_PROFILE="$(realpath repo_tool_configs/conan/conanprofile_debug.txt)"
export LOGURU_LEVEL=DEBUG

# export HAXORG_PY_LIB_VERBOSE_IMPORT_DEBUG=1
export HAXORG_PY_TEST_UV_INSTALL_DIR_OVERRIDE=/tmp/test_uv_install_tmp

append_json() {
    local name=$1
    shift

    local updated
    updated=$(jq -c --args '. + $ARGS.positional' -- "$@" <<< "${!name}") || return
    # assigns the formatted string directly to the variable named by
    printf -v "$name" '%s' "$updated"
}



export HSTD_PY_LLDB_ENABLED=true
export HSTD_PY_LLDB_SCRIPT="$PWD/hstd_py_lib/src/hstd_py_lib/debug_utils/bootstrap.py"
export HSTD_PY_LLDB_BREAKPOINT_FUNCTIONS='["__cxa_throw", "abort", "std::terminate"]'
export HSTD_PY_LLDB_FRAME_BLACKLIST='["_PyEval_.*^", "_PyObject_.*^", "slot_tp_call", "builtin_exec"]'
export HSTD_PY_LLDB_BINARY_FILE_FULL_PATH=true

export HSTD_PY_PYTEST_EXTRA_ARGS='["--color=no", "-vv"]'
append_json HSTD_PY_PYTEST_EXTRA_ARGS "--tb=short"
# append_json HSTD_PY_PYTEST_EXTRA_ARGS "--tb=long" "--showlocals" # very verbose backtrace
append_json HSTD_PY_PYTEST_EXTRA_ARGS "-n" "auto" # parallel pytest
# append_json HSTD_PY_PYTEST_EXTRA_ARGS "-s" # print test output even on OK code
# append_json HSTD_PY_PYTEST_EXTRA_ARGS "-k" "test_lldb_trace" # filter out tests


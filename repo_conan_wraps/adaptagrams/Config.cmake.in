@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/AdaptagramsTargets.cmake")

set(Adaptagrams_VERSION "@PROJECT_VERSION@")

set(_Adaptagrams_components
    avoid
    vpsc
    cola
    topology
    dialect
)

foreach(_component IN LISTS Adaptagrams_FIND_COMPONENTS)
    if(_component IN_LIST _Adaptagrams_components)
        set(Adaptagrams_${_component}_FOUND TRUE)
    else()
        set(Adaptagrams_${_component}_FOUND FALSE)
        set(Adaptagrams_NOT_FOUND_MESSAGE "Unknown Adaptagrams component: ${_component}")
    endif()
endforeach()

check_required_components(Adaptagrams)

unset(_component)
unset(_Adaptagrams_components)
